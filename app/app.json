{
  "expo": {
    "name": "Townaija",
    "slug": "townaija",
    "version": "1.2.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "ng.townaija.app",
      "versionCode": 11,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5EF3A"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Townaija uses your location to find tow trucks near you and to share an operator's position during a job."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Townaija uses the camera to photograph vehicles and documents.",
          "photosPermission": "Townaija lets you attach photos of your vehicle and documents."
        }
      ]
    ],
    "backgroundColor": "#EDEDED"
  }
}
